{
  "name": "mg-launcher",
  "productName": "MG Launcher",
  "version": "0.2.1",
  "description": "Launcher for Mini Games Studio maps",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:lock": "node scripts/lock.js",
    "pack:build": "node scripts/build-pack.js",
    "try:install": "node scripts/try-install.js",
    "try:launch": "node scripts/try-launch.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "node scripts/dist.js",
    "cover": "electron scripts/render-cover.js"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.m1haos.moplauncher",
    "productName": "MG Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MG Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "MG-Launcher-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "dist-pack",
        "to": "dist-pack",
        "filter": [
          "manifest.json",
          "*.mrpack",
          "*.png",
          "*.zip",
          "!mop1-*.mrpack",
          "!mop1-*.zip"
        ]
      }
    ]
  }
}
